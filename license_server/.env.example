# ====================================================================
# PITC Suite License Server Configuration
# Copy this file to .env for local development
# On Vercel: Set these under Project Settings -> Environment Variables
# ====================================================================

PORT=3000

# 1. Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# IMPORTANT: Use the SERVICE_ROLE secret key (not the anon public key)
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-service-role-key-here...

# 2. Secret password to authenticate admin endpoints (generate keys, set updates)
ADMIN_SECRET=change-this-to-a-very-secure-random-secret

# 3. GitHub Credentials for private repository update streaming proxy
GITHUB_TOKEN=github_pat_xxxx
GITHUB_REPO=naqasht128/PitcSuite

# 4. Optional Direct Fallback
LATEST_VERSION=2.8.91
LATEST_DOWNLOAD_URL=
